# Copy to .env.local for development, and set the same keys in the Amplify build.
#
# Scheme and host only, no trailing slash and no /api path — src/lib/api.ts appends
# /api/v1/... itself.
CRM_API_BASE_URL=https://api.housesixty.com

# Warehouse module ("Depo ve Stok", mockup screen 18). Off by default: it is priced
# and scheduled outside the five phases, and §13 of CRM.md lists five questions that
# need answering before it can be built. Set to true to show the nav entry.
CRM_FEATURE_WAREHOUSE=false
